# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Secret used to sign JWT tokens
JWT_SECRET=replace-with-a-long-random-string

# Allowed frontend origin(s). Comma-separated for multiple origins.
CLIENT_ORIGIN=http://localhost:3000

# Optional locally. Required on Vercel for cross-instance Socket.IO messages
# and online-user status (Upstash Redis from the Vercel Marketplace).
# REDIS_URL=rediss://default:PASSWORD@HOST:6379
# Upstash's Vercel integration also works via its KV_URL variable.
